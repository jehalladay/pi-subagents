{
  "name": "@tintinweb/pi-subagents",
  "version": "0.20.0",
  "engines": {
    "node": ">=24"
  },
  "description": "A pi extension that brings Claude Code-like sub-agents and workflow orchestration to pi \u2014 parallel execution, live widget, fleet view, custom agent types, mid-run steering, dynamic workflows, Claude Code compatibility, look and feel.",
  "author": "tintinweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tintinweb/pi-subagents.git"
  },
  "homepage": "https://github.com/tintinweb/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/tintinweb/pi-subagents/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "typebox": "*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@forge/sdk": "file:vendor/forge-sdk-0.1.0.tgz",
    "@furnace/sdk": "file:vendor/furnace-sdk-0.1.0.tgz",
    "@hyperunix/sdk": "file:vendor/hyperunix-sdk-0.1.0.tgz",
    "croner": "^10.0.1",
    "nanoid": "^5.1.16",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "pretest": "node -e \"require('fs').rmSync('.forge/vitest-report.json',{force:true})\"",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.forge/vitest-report.json --includeTaskLocation --expect.requireAssertions",
    "test:watch": "vitest",
    "test:e2e": "vitest run e2e --reporter=verbose",
    "test:census": "vitest run --config vitest.census.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "check": "npm run lint && npm run typecheck && npm run typecheck:test && npm run test",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:ab": "node test/perf/ab.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.5.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "marked": "18.0.11",
    "typebox": "^1.3.27",
    "vitest": "^4.0.18"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://github.com/tintinweb/pi-subagents/raw/master/media/demo.mp4",
    "image": "https://github.com/tintinweb/pi-subagents/raw/master/media/screenshot.png"
  },
  "bundledDependencies": [
    "@forge/sdk",
    "@furnace/sdk",
    "@hyperunix/sdk"
  ]
}
