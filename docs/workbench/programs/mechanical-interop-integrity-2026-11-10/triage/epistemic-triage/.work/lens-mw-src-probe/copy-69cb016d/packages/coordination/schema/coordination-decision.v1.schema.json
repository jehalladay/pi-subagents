{
  "$id": "mw.coordination-decision.v1",
  "title": "CoordinationDecisionV1",
  "description": "Typed immutable per-decision sidecar: pre-sampling vocabulary and support, sampled id with behavior logProb, RNG stream id, policy program/checkpoint digests, observation and read witness, prestate memory revision and native outcome correlation. Separate from TraceEvent, mw.episode.v1 and mw.training-export.v1; never serialized into TraceEvent.detail. Unknown values are the literal 'unknown'. sampled.logProb is a behavior log probability, so a number is at most 0. Every string member is non-blank. mode is the episode mode the decision was recorded under (a fixture record never upgrades); feedback.status is the closed enum {unknown, pending, final} and feedback.reward is numeric only when the status is final.",
  "type": "object",
  "required": ["schema", "version", "decisionId", "intentId", "graphId", "actorId", "nodeId", "observationDigest", "readSet", "policy", "vocabulary", "support", "sampled", "rng", "prestate", "nativeOutcomeRef", "mode", "feedback"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "mw.coordination-decision.v1"},
    "version": {"type": "integer", "const": 1},
    "decisionId": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "intentId": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "graphId": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "actorId": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nodeId": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "observationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "readSet": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "policy": {
      "type": "object", "required": ["programDigest", "checkpointDigest"], "additionalProperties": false,
      "properties": {
        "programDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "checkpointDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "vocabulary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "support": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "sampled": {
      "type": "object", "required": ["id", "logProb"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "logProb": {"oneOf": [{"type": "number", "maximum": 0}, {"type": "string", "const": "unknown"}]}
      }
    },
    "rng": {
      "type": "object", "required": ["streamId"], "additionalProperties": false,
      "properties": {"streamId": {"type": "string", "minLength": 1, "pattern": "\\S"}}
    },
    "prestate": {
      "type": "object", "required": ["memoryRevision"], "additionalProperties": false,
      "properties": {"memoryRevision": {"type": "string", "minLength": 1, "pattern": "\\S"}}
    },
    "nativeOutcomeRef": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "mode": {"type": "string", "enum": ["fixture", "replay", "live"]},
    "decisionSource": {"type": "string", "enum": ["mp", "fallback", "unknown"]},
    "fallbackPolicy": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
    "feedback": {
      "type": "object", "required": ["status", "reward"], "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["unknown", "pending", "final"]},
        "reward": {"oneOf": [{"type": "number"}, {"type": "string", "const": "unknown"}]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decisionSource": {"const": "fallback"}}, "required": ["decisionSource"]},
      "then": {"required": ["fallbackPolicy"]},
      "else": {"not": {"required": ["fallbackPolicy"]}}
    }
  ]
}
