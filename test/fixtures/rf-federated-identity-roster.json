  "excerpts": [
    {
      "at": "docs/programs/federated-workspaces-2026-10-18/03-protocol-and-storage.md:5",
      "line": "ResourceRef = {schema,workspace_id,backend_instance_id,resource_kind,resource_id,definition_digest}. ObservationRef adds source_revision, source_epoch, value_digest and optional provenance_digest. No implementation equates an alias or path with a global resource ID. Same W with different I represents a different runtime authority, as ADR-RFC-039 demands. Source revisions are opaque per owner/stream; do not order revisions from unrelated B instances."
    },
    {
      "at": "docs/programs/federated-workspaces-2026-10-18/03-protocol-and-storage.md:50",
      "line": "I02 No source revision counter compared across unrelated origin domains."
    },
    {
      "at": "docs/programs/federated-workspaces-2026-10-18/01-requirements-decisions.md:37",
      "line": "D03 Stable identities include (workspace_id, backend_instance_id) plus resource kind/id and immutable definition digest. Friendly aliases are local, mutable names."
