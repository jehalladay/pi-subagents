   "src/workbench/zz-handler-wrapped.ts": "type Registry = { invoke(...args: unknown[]): Promise<unknown>; inspect(...args: unknown[]): Promise<unknown> };\n// APO resource-pressure view handler.\nexport async function view(registry: Registry): Promise<unknown> {\n  await (registry.invoke)(\"apo.policy.apply\", {});\n  await registry.invoke!(\"apo.policy.apply\", {});\n  await (registry.invoke as Registry[\"invoke\"])(\"apo.policy.apply\", {});\n  await (registry.invoke satisfies Registry[\"invoke\"])(\"apo.policy.apply\", {});\n  return await (<Registry[\"invoke\"]>registry.invoke)(\"apo.policy.apply\", {});\n}\n",
